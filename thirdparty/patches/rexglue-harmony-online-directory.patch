+struct NatFixture {
+  std::vector<std::string> attempts;
+  std::vector<uint64_t> sockets;
+  ~NatFixture() {
+    for (auto socket : sockets)
+      NatProbeDetach(socket);
+    for (const auto& attempt : attempts)
+      NatProbeRetireIdentity(attempt);
