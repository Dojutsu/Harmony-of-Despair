+#pragma pack(push, 1)
+struct WireMember {
+  uint64_t xuid;
+  uint32_t flags;
+  char name[16];
+};
+struct DiscoveryPacket {
+  uint32_t magic;
+  uint16_t version;
+  uint8_t type;
+  uint8_t reserved;
+  uint32_t title_id;
+  uint8_t session_id[8];
+  uint8_t session_key[16];
+  uint64_t host_xuid;
+  uint32_t host_ipv4;
+  uint16_t host_port;
+  uint16_t reserved2;
+  uint32_t flags;
+  uint32_t public_slots;
+  uint32_t private_slots;
+  uint32_t member_count;
+  char host_name[16];
+  WireMember members[kMaxWireMembers];
+};
+#pragma pack(pop)
