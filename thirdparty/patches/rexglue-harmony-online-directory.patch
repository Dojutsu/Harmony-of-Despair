+  worker_gate.Release();
+  first.join();
+  second.join();
+  racing_search.join();
+  REQUIRE(cleanup_future.wait_for(std::chrono::seconds(2)) ==
+          std::future_status::ready);
+  manager.ShutdownAsyncActivity();
+  CHECK(by_code_requests.load() == 1);
