+bool NatProbeSelectInviteDiscoveryPeer(uint64_t socket, std::string_view attempt_id,
+                                       LanAddress peer);
+std::optional<LanAddress> NatProbeNormalizeGameplaySource(uint64_t socket,
+                                                          LanAddress source);
