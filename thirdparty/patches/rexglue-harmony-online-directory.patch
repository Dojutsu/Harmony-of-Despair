+  const char* local_app_data = std::getenv("LOCALAPPDATA");
+  if (local_app_data && *local_app_data)
+    return std::filesystem::path(local_app_data) / "HarmonyRecomp" / "active-invite-code.txt";
+#endif
+  return std::nullopt;
+}
