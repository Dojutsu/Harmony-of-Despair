+bool EnsureSocketRuntime() {
+#if REX_PLATFORM_WIN32
+  static std::once_flag once;
+  static bool initialized = false;
+  std::call_once(once, [] {
+    WSADATA data{};
+    initialized = WSAStartup(MAKEWORD(2, 2), &data) == 0;
+  });
+  return initialized;
+#else
+  return true;
+#endif
+}
