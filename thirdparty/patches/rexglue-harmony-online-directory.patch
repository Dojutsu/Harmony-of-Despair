+uint64_t ClientSwap64(uint64_t value) {
+  const uint32_t high = htonl(static_cast<uint32_t>(value >> 32));
+  const uint32_t low = htonl(static_cast<uint32_t>(value));
+  return (uint64_t(low) << 32) | high;
+}
