+                      "IPv4 UDP NAT traversal rendezvous server")
+    .lifecycle(rex::cvar::Lifecycle::kInitOnly);
+REXCVAR_DEFINE_UINT32(nat_probe_port, 30740, "Network", "NAT traversal rendezvous UDP port")
+    .range(1, 65535)
