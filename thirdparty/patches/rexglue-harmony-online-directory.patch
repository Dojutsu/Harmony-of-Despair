+bool IsLowerHex128(std::string_view value) {
+  return value.size() == 32 && std::all_of(value.begin(), value.end(), [](char ch) {
+           return (ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'f');
+         });
+}
