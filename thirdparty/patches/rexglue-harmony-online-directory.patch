+    DirectoryTraversalAttempt attempt;
+    std::string generation;
+    std::atomic<bool> cancelled{false};
+    std::chrono::steady_clock::time_point claim_deadline{}, next_poll{};
+    std::optional<GameplayAuthorization> authorization;
