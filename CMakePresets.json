        {
            "name": "linux-steamos-amd64-l0-local",
            "displayName": "Linux L0 native unit tests without broadcast fixtures",
            "description": "Runs ordinary native unit/kernel tests; excludes the nine reviewed broadcast cases and two hidden gameplay fixtures.",
            "configurePreset": "linux-steamos-amd64-l0",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            },
            "filter": {
                "include": {
                    "name": "^(unit\\.|xgi_slot_array$|accepted_invite_kernel$|video_swap$|indirect_dispatch$|linux_startup$|linux_guest_fault$|recvfrom_lifetime$)"
                },
                "exclude": {
                    "name": "^unit\\.(LAN discovery advertises and returns a created session|unreachable session directory preserves LAN discovery|pending NAT traversal preserves LAN broadcast discovery|stopping a LAN advertisement removes the hosted session|production public Search leaves invite admission isolated|configured invite claim is one-flight and isolated from public Search|configured invite cancellation gates every discovery send boundary|configured invite reaches immutable READY result using its own endpoint|lease renewal cancellation rejects the in-flight late callback|gameplay directory worker survives manual admission and joins at shutdown|production admission to independent gameplay sockets fixture)$"
                }
            },
            "execution": {
                "jobs": 1,
                "timeout": 60,
                "noTestsAction": "error"
            },
            "condition": {
                "type": "allOf",
                "conditions": [
                    {
                        "type": "equals",
                        "lhs": "${hostSystemName}",
                        "rhs": "Linux"
                    },
                    {
                        "type": "notEquals",
                        "lhs": "$env{REXGLUE_LINUX_BUILD_ROOT}",
                        "rhs": ""
                    }
                ]
            }
        },
        {
            "name": "linux-steamos-amd64-l0-broadcast-isolated",
            "displayName": "Linux L0 nine broadcast tests in an isolated network",
            "description": "Requires an isolated BuildServer network; do not run this preset on an unisolated playtest device.",
            "configurePreset": "linux-steamos-amd64-l0",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            },
            "filter": {
                "include": {
                    "name": "^unit\\.(LAN discovery advertises and returns a created session|unreachable session directory preserves LAN discovery|pending NAT traversal preserves LAN broadcast discovery|stopping a LAN advertisement removes the hosted session|production public Search leaves invite admission isolated|configured invite claim is one-flight and isolated from public Search|configured invite cancellation gates every discovery send boundary|configured invite reaches immutable READY result using its own endpoint|lease renewal cancellation rejects the in-flight late callback)$"
                }
            },
            "execution": {
                "jobs": 1,
                "timeout": 60,
                "noTestsAction": "error"
            },
            "condition": {
                "type": "allOf",
                "conditions": [
                    {
