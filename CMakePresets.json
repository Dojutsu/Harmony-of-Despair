{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "windows-base",
            "hidden": true,
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_FLAGS": "-march=x86-64-v2",
                "CMAKE_CXX_FLAGS": "-march=x86-64-v2",
                "CMAKE_CXX_STANDARD": "23",
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo",
                "CMAKE_CROSS_CONFIGS": "all",
                "CMAKE_DEFAULT_BUILD_TYPE": "Debug",
                "CMAKE_DEFAULT_CONFIGS": "all",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux-base",
            "hidden": true,
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_FLAGS": "-march=x86-64-v2",
                "CMAKE_CXX_FLAGS": "-march=x86-64-v2",
                "CMAKE_CXX_STANDARD": "23",
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo",
                "CMAKE_CROSS_CONFIGS": "all",
                "CMAKE_DEFAULT_BUILD_TYPE": "Debug",
                "CMAKE_DEFAULT_CONFIGS": "all",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "mac-base",
            "hidden": true,
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_FLAGS": "-march=x86-64-v3",
                "CMAKE_CXX_FLAGS": "-march=x86-64-v3",
                "CMAKE_CXX_STANDARD": "23",
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo",
                "CMAKE_CROSS_CONFIGS": "all",
                "CMAKE_DEFAULT_BUILD_TYPE": "Debug",
                "CMAKE_DEFAULT_CONFIGS": "all",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_OSX_ARCHITECTURES": "x86_64"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "windows-arm64-base",
            "hidden": true,
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_C_FLAGS": "-march=armv8-a",
                "CMAKE_CXX_FLAGS": "-march=armv8-a"
            }
        },
        {
            "name": "linux-arm64-base",
            "hidden": true,
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_C_FLAGS": "-march=armv8-a",
                "CMAKE_CXX_FLAGS": "-march=armv8-a"
            }
        },
        {
            "name": "mac-arm64-base",
            "hidden": true,
            "inherits": "mac-base",
            "cacheVariables": {
                "CMAKE_C_FLAGS": "-march=armv8-a",
                "CMAKE_CXX_FLAGS": "-march=armv8-a",
                "CMAKE_OSX_ARCHITECTURES": "arm64"
            }
        },
        {
            "name": "win-amd64",
            "displayName": "Windows AMD64",
            "description": "Multi-config build for Windows AMD64 using Clang",
            "inherits": "windows-base"
        },
        {
            "name": "win-arm64",
            "displayName": "Windows ARM64",
            "description": "Multi-config build for Windows ARM64 using Clang",
            "inherits": "windows-arm64-base"
        },
        {
            "name": "linux-amd64",
            "displayName": "Linux AMD64",
            "description": "Multi-config build for Linux AMD64 using Clang",
            "inherits": "linux-base"
        },
        {
            "name": "linux-arm64",
            "displayName": "Linux ARM64",
            "description": "Multi-config build for Linux ARM64 using Clang",
            "inherits": "linux-arm64-base"
        },
        {
            "name": "mac-amd64",
            "displayName": "macOS AMD64",
            "description": "Multi-config build for macOS AMD64 using Clang",
            "inherits": "mac-base"
        },
        {
            "name": "mac-arm64",
            "displayName": "macOS ARM64",
            "description": "Multi-config build for macOS ARM64 using Clang",
            "inherits": "mac-arm64-base"
        },
        {
            "name": "linux-steamos-amd64-l0",
            "displayName": "SteamOS Linux AMD64 L0",
            "description": "Native x86-64 SDK preparation with Clang 19 in the pinned Steam Linux Runtime 4 SDK",
            "inherits": "linux-base",
            "binaryDir": "$env{REXGLUE_LINUX_BUILD_ROOT}/sdk",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang-19",
                "CMAKE_CXX_COMPILER": "clang++-19",
                "CMAKE_INSTALL_PREFIX": "$env{REXGLUE_LINUX_BUILD_ROOT}/sdk/install",
                "REXGLUE_OUTPUT_DIR": "$env{REXGLUE_LINUX_BUILD_ROOT}/sdk/bin",
                "REXGLUE_BUILD_TESTS": "ON",
                "REXGLUE_USE_VULKAN": "ON",
                "REXGLUE_ENABLE_FIDELITYFX": "OFF",
                "REXGLUE_ENABLE_TRACY": "OFF",
                "REXGLUE_ENABLE_PERF_COUNTERS": "OFF"
            },
            "condition": {
                "type": "allOf",
                "conditions": [
                    {
                        "type": "equals",
                        "lhs": "${hostSystemName}",
                        "rhs": "Linux"
                    },
                    {
                        "type": "notEquals",
                        "lhs": "$env{REXGLUE_LINUX_BUILD_ROOT}",
                        "rhs": ""
                    }
                ]
            }
        }
    ],
