//=============================================================================
// Indirect Call Dispatch
//
// Native call targets come only from the host-owned FunctionDispatcher registry.
// Guest-address-space dispatch tables remain a compatibility mirror, never a
// source of callable host pointers. Corrupt, unaligned or unregistered guest
// targets resolve to the existing invalid-function trap.
//=============================================================================

#ifdef REXGLUE_ENABLE_PROFILING
#include <rex/perf/counter.h>
#define REX_PROFILE_INDIRECT_DISPATCH() PROFILE_FUNCTION_DISPATCHED()
#else
#define REX_PROFILE_INDIRECT_DISPATCH()
#endif

#define REX_LOOKUP_FUNC(x, y) \
  ((void)(x), rex::runtime::ResolveIndirectFunction(uint32_t(y)))

#define REX_CALL_INDIRECT_FUNC(x)                                             \
  do {                                                                       \
    REX_PROFILE_INDIRECT_DISPATCH();                                          \
    uint32_t rex_indirect_target_ = uint32_t(x);                               \
    ctx.last_indirect_target = rex_indirect_target_;                          \
    PPCFunc* rex_indirect_func_ = REX_LOOKUP_FUNC(base, rex_indirect_target_); \
    rex_indirect_func_(ctx, base);                                            \
  } while (0)
