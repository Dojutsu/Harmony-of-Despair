#include <windows.h>

// The app icon is local art kept out of the repository; CMake defines
// HARMONY_LAUNCHER_ICON only when tools/launcher/Harmony.ico is present.
#ifdef HARMONY_LAUNCHER_ICON
1 ICON "Harmony.ico"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Harmony of Despair"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "harmony_launcher"
            VALUE "OriginalFilename", "Harmony of Despair.exe"
            VALUE "ProductName", "Harmony of Despair"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
